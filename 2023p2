import sqlite3

# Create/Open the database
connection = sqlite3.connect(r"H:\New folder\TESTDATABASE.db")

# Create a cursor
cursor = connection.cursor()

# Create the Student table
cursor.execute("""
CREATE TABLE IF NOT EXISTS Student (
    StudentID INTEGER PRIMARY KEY,
    GivenName TEXT NOT NULL,
    FamilyName TEXT NOT NULL,
    ClassName TEXT NOT NULL
)
""")

# Create the Test table
cursor.execute("""
CREATE TABLE IF NOT EXISTS Test (
    TestID TEXT PRIMARY KEY,
    MaxMarks INTEGER NOT NULL
)
""")

# Create the Class table
cursor.execute("""
CREATE TABLE IF NOT EXISTS Class (
    ClassName TEXT PRIMARY KEY,
    YearGroup INTEGER NOT NULL
)
""")

#Create the Student_Test table
cursor.execute("""
CREATE TABLE IF NOT EXISTS Student_Test (
    StudentTestID INTEGER PRIMARY KEY,
    StudentID INTEGER NOT NULL,
    TestID TEXT NOT NULL,
    Mark INTEGER NOT NULL,
    DateTest TEXT NOT NULL,
    FOREIGN KEY (StudentID) REFERENCES Student(StudentID),
    FOREIGN KEY (TestID) REFERENCES Test(TestID)
)
""")


connection.commit()
connection.close()

